{
	"schemaVersion": 1,
	"id": "autotoggle",
	"version": "${version}",
	"name": "AutoToggle",
	"description": "Adds toggle-based automation for repetitive keybinds.",
	"authors": [
		"3C Team"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/auto-toggle",
		"issues": "https://github.com/3ColumnsC/AutoToggle/issues",
		"sources": "https://github.com/3ColumnsC/AutoToggle"
	},
	"license": "MIT",
	"icon": "assets/autotoggle/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.threecolumnsstudio.autotoggle.fabric.AutoToggleFabric"
		]
	},
	"mixins": [
		"autotoggle.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.157.0"
	}
}
